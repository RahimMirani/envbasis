# EnvBasis backend production configuration.
# Copy to backend.env, replace every placeholder, and chmod 600 backend.env.

APP_ENV=production
ENVBASIS_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Use the Supabase Session Pooler on port 5432 when the EC2 host is IPv4-only.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# A Fernet key is still required for legacy/local wrapped data and startup validation.
SECRETS_MASTER_KEY=replace-with-fernet-key
SECRETS_ROOT_KEY_PROVIDER=aws_kms
AWS_KMS_KEY_ID=arn:aws:kms:AWS_REGION:AWS_ACCOUNT_ID:key/KMS_KEY_ID
AWS_KMS_REGION=us-west-2

# Generate these independently and never reuse them.
CLI_AUTH_JWT_SECRET=replace-with-long-random-secret
MACHINE_AUTH_JWT_SECRET=replace-with-a-different-long-random-secret
MACHINE_AUTH_JWT_ALGORITHM=HS256
MACHINE_AUTH_JWT_ISSUER=envbasis-machine-auth
MACHINE_AUTH_JWT_AUDIENCE=envbasis-machine
API_IDEMPOTENCY_ENCRYPTION_KEY=replace-with-a-different-fernet-key

# REDIS_URL is injected by Compose so it matches the Redis container password.
RATE_LIMIT_BACKEND=redis
REDIS_KEY_PREFIX=envbasis
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

CORS_ALLOWED_ORIGINS=https://app.example.com
INVITE_APP_BASE_URL=https://app.example.com
CLI_AUTH_VERIFICATION_URL=https://app.example.com/cli

# Leave disabled unless the webhook-worker Compose profile is also started.
WEBHOOKS_ENABLED=false

# Optional SMTP configuration.
# INVITE_SMTP_HOST=smtp.example.com
# INVITE_SMTP_PORT=587
# INVITE_SMTP_USER=
# INVITE_SMTP_PASSWORD=
# INVITE_FROM_EMAIL=EnvBasis <noreply@example.com>
# INVITE_SMTP_USE_TLS=true
