# EnvBasis proxy production configuration.
# Copy to proxy.env, replace placeholders, and chmod 600 proxy.env.

APP_ENV=production

# These four settings must match the backend exactly.
MACHINE_AUTH_JWT_SECRET=copy-the-exact-backend-value
MACHINE_AUTH_JWT_ALGORITHM=HS256
MACHINE_AUTH_JWT_ISSUER=envbasis-machine-auth
MACHINE_AUTH_JWT_AUDIENCE=envbasis-machine

# Configure at least one provider. Keep these credentials only on the proxy host.
OPENAI_API_KEY=
GITHUB_TOKEN=

UPSTREAM_TIMEOUT_SECONDS=60
MAX_REQUEST_BYTES=2097152
MAX_RESPONSE_BYTES=20971520
