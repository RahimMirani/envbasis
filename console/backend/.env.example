DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
ENVBASIS_DEBUG=false
SECRETS_MASTER_KEY=<your-fernet-key>
# Use aws_kms in production to generate and unwrap project data keys with AWS KMS.
SECRETS_ROOT_KEY_PROVIDER=local
# AWS_KMS_KEY_ID=alias/envbasis
# AWS_KMS_REGION=us-west-2
# AWS_KMS_ENDPOINT_URL=
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
CLI_AUTH_JWT_SECRET=<any-long-random-secret>
# Signs short-lived machine access tokens. Use a separate, long random production secret.
MACHINE_AUTH_JWT_SECRET=<another-long-random-secret>
# Shared secret the proxy uses to resolve platform-stored provider keys.
# PROXY_SERVICE_TOKEN=<long-random-token>
# MACHINE_AUTH_DEFAULT_ACCESS_TOKEN_TTL_SECONDS=3600
# MACHINE_AUTH_MIN_ACCESS_TOKEN_TTL_SECONDS=300
# MACHINE_AUTH_MAX_ACCESS_TOKEN_TTL_SECONDS=86400
# MACHINE_AUTH_MAX_FAILED_ATTEMPTS=5
# MACHINE_AUTH_LOCKOUT_SECONDS=900
# MACHINE_AUTH_DEFAULT_ROTATION_OVERLAP_SECONDS=0
# Webhooks are excluded from the current MVP. Enable only when the worker is deployed.
WEBHOOKS_ENABLED=false
# Durable webhook worker and retry policy.
# WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_RETRY_BASE_SECONDS=30
# WEBHOOK_RETRY_MAX_SECONDS=3600
# WEBHOOK_WORKER_POLL_SECONDS=1.0
# WEBHOOK_WORKER_BATCH_SIZE=25
# Shared production rate limiting. Memory mode is intended only for local development/tests.
RATE_LIMIT_BACKEND=memory
# REDIS_URL=rediss://default:<password>@<host>:6379/0
# REDIS_KEY_PREFIX=envbasis
# REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# LOG_LEVEL=INFO
# LOG_JSON=true
# Encrypts cached idempotent responses, including one-time credential responses.
# Generate independently with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_IDEMPOTENCY_ENCRYPTION_KEY=<your-fernet-key>
# API_IDEMPOTENCY_RETENTION_SECONDS=86400
# API_IDEMPOTENCY_PENDING_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the dashboard (used in project invite emails as ?invite=<token>)
INVITE_APP_BASE_URL=http://localhost:5173
# Optional: send invite emails via SMTP. If unset, invites are stored and the link is logged server-side.
# INVITE_SMTP_HOST=
# INVITE_SMTP_PORT=587
# INVITE_SMTP_USER=
# INVITE_SMTP_PASSWORD=
# INVITE_FROM_EMAIL=
# INVITE_SMTP_USE_TLS=true
