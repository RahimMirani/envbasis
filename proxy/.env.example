APP_ENV=development

# Must match the console backend's MACHINE_AUTH_JWT_SECRET and JWT settings.
MACHINE_AUTH_JWT_SECRET=replace-me
MACHINE_AUTH_JWT_ALGORITHM=HS256
MACHINE_AUTH_JWT_ISSUER=envbasis-machine-auth
MACHINE_AUTH_JWT_AUDIENCE=envbasis-machine

# Fetch provider keys from the console. Do not put OpenAI/Anthropic/GitHub keys here.
CONTROL_PLANE_URL=http://127.0.0.1:8000
PROXY_SERVICE_TOKEN=replace-me

UPSTREAM_TIMEOUT_SECONDS=60
MAX_REQUEST_BYTES=2097152
MAX_RESPONSE_BYTES=20971520
